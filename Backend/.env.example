
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

DB_ENGINE=django.db.backends.postgresql
DB_NAME=nearbyme_master_db
DB_USER=postgres_user
DB_PASS=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

CLOUD_STORAGE_BUCKET=kyc-private-documents
SIGNED_URL_EXPIRY_SECONDS=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

TOTP_ENCRYPTION_KEY=
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
INACTIVITY_EXPIRY_MINUTES=60

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MSG91 (SMS OTP delivery) — MSG91_OTP_TEMPLATE_ID must be a DLT-approved
# transactional template from your MSG91 dashboard containing an ##OTP##
# placeholder. Both blank = OTPs stay in dev mode (logged + returned in the
# API response), same "not configured" pattern as Razorpay above.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
